# Copy to .env and fill in. `.env` is git-ignored; never commit real secrets.

# --- Immich -------------------------------------------------------------------

# Base URL of your Immich server, reachable from inside the container.
# `host.docker.internal` works when Immich publishes port 2283 on this host.
# On a shared Docker network, use Immich's service name instead, for example
#   IMMICH_URL=http://immich-server:2283
IMMICH_URL=http://host.docker.internal:2283

# Immich → Account Settings → API Keys. Required scopes:
#   asset.read, asset.download, asset.upload, asset.update, asset.delete,
#   album.read, albumAsset.create, tag.read, tag.create, tag.asset,
#   person.read, user.read, queue.read, queue.update
IMMICH_API_KEY=

# --- Web UI -------------------------------------------------------------------

# Basic-auth password for this optimizer, at least 12 characters.
WEB_PASSWORD=

# Only set to true behind a proxy that authenticates every request; see README.md.
# WEB_AUTH_DISABLED=false

# Optional cleanup buttons, as label:lucide-icon pairs (icons: https://lucide.dev/icons).
# EXTRA_BUTTONS=Trips:plane,Family:users

# --- Deployment ---------------------------------------------------------------

# Host port of the UI; the container always listens on 3000.
# HOST_PORT=3000

# Image to run. The default is the published web image for the `web-ui` branch.
# IMMICH_WEB_IMAGE=ghcr.io/matyifkbt/immich-upload-optimizer-web:latest
