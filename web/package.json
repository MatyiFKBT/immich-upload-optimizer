{
  "name": "immich-web-media-optimizer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p client/tsconfig.json",
    "dev": "vite",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@immich/sdk": "3.3.0-rc.0",
    "@tanstack/react-hotkeys": "^0.16.0",
    "@tanstack/react-virtual": "^3.14.20",
    "hono": "^4.13.13",
    "nuqs": "^2.10.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.30",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.54.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
